{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main Presence Bridge window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "slack:*" },
        { "url": "msteams:*" },
        { "url": "zoommtg:*" }
      ]
    }
  ]
}
